# APSA Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# This file (with empty values only) is safe to commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# APSA's dedicated Supabase project — Seoul (ap-northeast-2) region.
# Never share this project with Domner or any other app.
# Do NOT create a new project — APSA already has its own.
#
# Find these values in the Supabase Dashboard → Project Settings → API.

# Public API URL (visible to browser and server)
VITE_SUPABASE_URL=

# Anon/public key — safe to use in the browser for auth-gated operations only
VITE_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to browser, never put in VITE_ prefix.
# Used for privileged server-side operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: SUPABASE_JWT_SECRET is NOT used.
# Session validation uses supabase.auth.getUser() via the Supabase SDK, which verifies
# JWTs server-side without requiring the raw secret in application code.
# If the project later adopts getClaims/JWKS, that is a documented optimization and
# must not be introduced until it is explicitly needed.

# ── Application ──────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash)
VITE_APP_URL=

# Node environment: development | production | test
NODE_ENV=development

# ── Exchange Rate ────────────────────────────────────────────────────────────
# Configurable KHR/USD rate. Never hardcode this as a constant in app code.
# Default shown; override in production to match current rate.
VITE_KHR_PER_USD=4100
