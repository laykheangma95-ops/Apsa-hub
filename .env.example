# APSA Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# This file (with empty values only) is safe to commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# APSA's dedicated Supabase project — Seoul (ap-northeast-2) region.
# Never share this project with Domner or any other app.
# Do NOT create a new project — APSA already has its own.
#
# Find these values in the Supabase Dashboard → Project Settings → API.

# Public API URL (visible to browser and server)
VITE_SUPABASE_URL=

# Anon/public key — safe to use in the browser for auth-gated operations only
VITE_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to browser, never put in VITE_ prefix.
# Used for privileged server-side operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: SUPABASE_JWT_SECRET is NOT used.
# Session validation uses supabase.auth.getUser() via the Supabase SDK, which verifies
# JWTs server-side without requiring the raw secret in application code.
# If the project later adopts getClaims/JWKS, that is a documented optimization and
# must not be introduced until it is explicitly needed.

# ── Application ──────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash)
VITE_APP_URL=

# Node environment: development | production | test
# Local development only. Do NOT set this in a deploy provider's build environment:
# NODE_ENV=development makes `vite build` emit the development JSX runtime (jsxDEV)
# into the production SSR bundle, which crashes SSR at runtime.
NODE_ENV=development

# ── Exchange Rate ────────────────────────────────────────────────────────────
# Configurable KHR/USD rate. Never hardcode this as a constant in app code.
# Default shown; override in production to match current rate.
VITE_KHR_PER_USD=4100

# ── Staging verification (optional; never committed with real values) ────────
# Used ONLY by scripts/verify-staging.ts. These point at a DEDICATED staging
# Supabase project that is separate from production — the script refuses to run
# when STAGING_SUPABASE_URL and the production URL witness resolve to the same
# project, and it refuses to run at all when no production URL witness is set.
# Put real values in .env.staging.local (git-ignored) or your shell, never here.
# See docs/STAGING_VERIFICATION.md for what each value is and where to find it.

STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
# Staging service-role key — SERVER/CLI ONLY. Never a VITE_ prefix.
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Two staging organizations with no shared membership, used to prove tenant
# isolation with real UUIDs rather than guessed ones.
STAGING_ORG_A_ID=
STAGING_ORG_B_ID=

# Production URL witness — MANDATORY for scripts/verify-staging.ts.
# Without a production URL to compare against, "this is not production" is an
# unanswered question and no hosted probe may run. VITE_SUPABASE_URL above also
# satisfies this; set PRODUCTION_SUPABASE_URL when the two are configured
# separately. This is a project URL, not a credential.
PRODUCTION_SUPABASE_URL=

# Bounded execution for scripts/verify-staging.ts (milliseconds, optional).
# Defaults: 15000 per hosted request, 300000 for the whole run. An unreachable
# staging project ends the run instead of hanging.
STAGING_REQUEST_TIMEOUT_MS=
STAGING_GLOBAL_TIMEOUT_MS=

# Staging test accounts. All must have VERIFIED emails and contain only
# disposable data — never point these at a real customer record.
STAGING_OWNER_A_EMAIL=
STAGING_OWNER_A_PASSWORD=
STAGING_MANAGER_A_EMAIL=
STAGING_MANAGER_A_PASSWORD=
STAGING_STAFF_A_EMAIL=
STAGING_STAFF_A_PASSWORD=
STAGING_OWNER_B_EMAIL=
STAGING_OWNER_B_PASSWORD=
